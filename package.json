{
  "name": "help-center",
  "version": "0.1.0",
  "private": true,
  "description": "Help and FAQ for Phi Browser.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev site --port ${PORT:-3000}",
    "build": "pnpm test:i18n && vitepress build site && pnpm test:i18n:build",
    "preview": "vitepress preview site --port ${PORT:-3000}",
    "i18n:scaffold": "node scripts/scaffold-locale.mjs",
    "i18n:status": "node scripts/check-localization-status.mjs",
    "i18n:promote": "node scripts/promote-locale.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:i18n:build": "node scripts/test-i18n-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "vitepress": "^1.6.4",
    "wrangler": "^4.104.0"
  },
  "dependencies": {
    "posthog-js": "^1.398.2",
    "zod": "^4.4.3"
  }
}
